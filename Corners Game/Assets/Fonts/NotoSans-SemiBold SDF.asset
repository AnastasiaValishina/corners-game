    characterSetSelectionMode: 7
    characterSequence: "\u0423\u0413\u041E\u041B\u041A\u0418\n\u041F\u0440\u0430\u0432\u0438\u043B\u0430:\n\u0417\u0432\u0443\u043A\n\u041C\u0443\u0437\u044B\u043A\u0430\n\u0413\u043B\u0430\u0432\u043D\u043E\u0435
      \u043C\u0435\u043D\u044E\n\u041D\u0430\u0447\u0430\u0442\u044C \u0437\u0430\u043D\u043E\u0432\u043E\n\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C\n\u0418\u0433\u0440\u0430
      \u043D\u0430 \u0434\u0432\u043E\u0438\u0445\n\u0412\u044B\u0431\u0435\u0440\u0435\u0442\u0435
      \u0441\u043B\u043E\u0436\u043D\u043E\u0441\u0442\u044C\n\u041B\u0435\u0433\u043A\u043E\n\u041D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E\n\u0421\u043B\u043E\u0436\u043D\u043E\n\u041F\u0440\u043E\u0442\u0438\u0432
      \u041F\u041A\n\u0425\u043E\u0434:\n\u041F\u041E\u0411\u0415\u0414\u0410\n\u041F\u041E\u0420\u0410\u0416\u0415\u041D\u0418\u0415!\n\u0421\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043A\u0430\n\u041F\u041E\u0411\u0415\u0414\u0410
      \u0411\u0415\u041B\u042B\u0425 \u0427\u0415\u0420\u041D\u042B\u0425\n\u0428\u0430\u0448\u043A\u0430
      \u0445\u043E\u0434\u0438\u0442 \u0438\u043B\u0438 \u043F\u0440\u044B\u0433\u0430\u0435\u0442
      \u0442\u043E\u043B\u044C\u043A\u043E \u0432 \u0432\u0435\u0440\u0442\u0438\u043A\u0430\u043B\u044C\u043D\u043E\u043C
      \u0438\u043B\u0438 \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u0430\u043B\u044C\u043D\u043E\u043C
      \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0438\n\u0428\u0430\u0448\u043A\u0443
      \u043C\u043E\u0436\u043D\u043E \u043F\u0435\u0440\u0435\u043C\u0435\u0449\u0430\u0442\u044C
      \u043F\u043E \u0432\u0441\u0435\u043C \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F\u043C\nC\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043A\u0430
      \nCORNERS\r\nHotseat \r\nComputer\r\nStart again\r\nMain menu\r\nVICTORY!\r\nDEFEAT\r\nWHITE
      WINS! BLACK\r\nMode\r\n\u0420\u0435\u0436\u0438\u043C\r\nClassic mode\r\nDiagonal
      mode\r\nThe piece can be moved in all directions\r\nThe piece moves or jumps
      only horizontally or vertically \r\nPlay\r\nChoose difficulty\r\nEasy\r\nNormal\r\nHard\r\nStatistics\r\nMusic\r\nPlayer\r\nSound\r\nContinue"
